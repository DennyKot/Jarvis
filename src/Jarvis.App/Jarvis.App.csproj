<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\jarvis.ico</ApplicationIcon>
    <UserSecretsId>jarvis-assistant-6f1c2e0a</UserSecretsId>
    <AssemblyName>Jarvis</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="SkiaSharp.Skottie" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <!-- Referenced directly so their native/driver assets are copied to the app output. -->
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Whisper.net.Runtime" />
    <!-- GPU speech recognition on any Vulkan-capable GPU; falls back to the CPU runtime automatically. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jarvis.Core\Jarvis.Core.csproj" />
    <ProjectReference Include="..\Jarvis.Voice\Jarvis.Voice.csproj" />
    <ProjectReference Include="..\Jarvis.Automation.Browser\Jarvis.Automation.Browser.csproj" />
    <ProjectReference Include="..\Jarvis.Automation.Desktop\Jarvis.Automation.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Avatar\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
