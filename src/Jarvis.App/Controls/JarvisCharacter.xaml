<UserControl x:Class="Jarvis.App.Controls.JarvisCharacter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="170" Height="190">
    <Canvas x:Name="Stage" Width="170" Height="190" ClipToBounds="False">
        <!-- Ground shadow -->
        <Ellipse x:Name="Shadow" Canvas.Left="45" Canvas.Top="168" Width="80" Height="14" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#55000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="ShadowScale" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Thinking / acting orbit -->
        <Canvas x:Name="Orbit" Canvas.Left="85" Canvas.Top="92" Opacity="0">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="OrbitRotate" />
            </Canvas.RenderTransform>
            <Ellipse x:Name="OrbitDot1" Width="10" Height="10" Canvas.Left="-5" Canvas.Top="-88" />
            <Ellipse x:Name="OrbitDot2" Width="7" Height="7" Canvas.Left="72" Canvas.Top="40" />
            <Ellipse x:Name="OrbitDot3" Width="8" Height="8" Canvas.Left="-80" Canvas.Top="40" />
        </Canvas>

        <Canvas x:Name="Body" Width="170" Height="170" RenderTransformOrigin="0.5,0.9">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BodyScale" />
                    <RotateTransform x:Name="BodyRotate" />
                    <TranslateTransform x:Name="BodyTranslate" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Antenna -->
            <Rectangle Canvas.Left="83" Canvas.Top="14" Width="4" Height="22" RadiusX="2" RadiusY="2" Fill="#9AA7D6" />
            <Ellipse x:Name="AntennaBall" Canvas.Left="76" Canvas.Top="2" Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <SolidColorBrush x:Name="AntennaBrush" Color="#00E5FF" />
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="AntennaScale" />
                </Ellipse.RenderTransform>
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="AntennaGlow" Color="#00E5FF" BlurRadius="18" ShadowDepth="0" Opacity="1" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- Ears -->
            <Rectangle Canvas.Left="10" Canvas.Top="70" Width="18" Height="38" RadiusX="8" RadiusY="8" Stroke="#8F9BD8" StrokeThickness="2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#B8C2F0" Offset="0" />
                        <GradientStop Color="#E8ECFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Canvas.Left="142" Canvas.Top="70" Width="18" Height="38" RadiusX="8" RadiusY="8" Stroke="#8F9BD8" StrokeThickness="2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E8ECFF" Offset="0" />
                        <GradientStop Color="#B8C2F0" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Head -->
            <Rectangle x:Name="Head" Canvas.Left="22" Canvas.Top="32" Width="126" Height="114" RadiusX="50" RadiusY="48" Stroke="#8F9BD8" StrokeThickness="2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#E3E8FF" Offset="0.55" />
                        <GradientStop Color="#B5C0F2" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Effect>
                    <DropShadowEffect Color="#5B6BC0" BlurRadius="16" ShadowDepth="3" Opacity="0.35" Direction="270" />
                </Rectangle.Effect>
            </Rectangle>
            <Ellipse Canvas.Left="42" Canvas.Top="40" Width="48" Height="18" Fill="#B3FFFFFF">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-12" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Face screen -->
            <Rectangle Canvas.Left="38" Canvas.Top="62" Width="94" Height="64" RadiusX="26" RadiusY="26" Stroke="#2E3A8C" StrokeThickness="2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#232A55" Offset="0" />
                        <GradientStop Color="#131733" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Cheeks -->
            <Ellipse Canvas.Left="44" Canvas.Top="104" Width="14" Height="8" Fill="#66FF7EB6" />
            <Ellipse Canvas.Left="112" Canvas.Top="104" Width="14" Height="8" Fill="#66FF7EB6" />

            <!-- Eyes -->
            <Canvas x:Name="Eyes">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="EyesTranslate" />
                </Canvas.RenderTransform>
                <Rectangle x:Name="LeftEye" Canvas.Left="58" Canvas.Top="76" Width="16" Height="24" RadiusX="8" RadiusY="8"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.Fill>
                        <SolidColorBrush x:Name="LeftEyeBrush" Color="#00E5FF" />
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="LeftEyeScale" />
                    </Rectangle.RenderTransform>
                    <Rectangle.Effect>
                        <DropShadowEffect x:Name="LeftEyeGlow" Color="#00E5FF" BlurRadius="12" ShadowDepth="0" />
                    </Rectangle.Effect>
                </Rectangle>
                <Rectangle x:Name="RightEye" Canvas.Left="96" Canvas.Top="76" Width="16" Height="24" RadiusX="8" RadiusY="8"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.Fill>
                        <SolidColorBrush x:Name="RightEyeBrush" Color="#00E5FF" />
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="RightEyeScale" />
                    </Rectangle.RenderTransform>
                    <Rectangle.Effect>
                        <DropShadowEffect x:Name="RightEyeGlow" Color="#00E5FF" BlurRadius="12" ShadowDepth="0" />
                    </Rectangle.Effect>
                </Rectangle>
            </Canvas>
            <Path x:Name="ErrorEyes" Opacity="0" Stroke="#FF4D4D" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M59,80 L73,96 M73,80 L59,96 M97,80 L111,96 M111,80 L97,96" />

            <!-- Mouths -->
            <Path x:Name="Smile" Data="M74,110 Q85,118 96,110" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Stroke>
                    <SolidColorBrush x:Name="SmileBrush" Color="#00E5FF" />
                </Path.Stroke>
            </Path>
            <Ellipse x:Name="OpenMouth" Canvas.Left="78" Canvas.Top="106" Width="14" Height="10" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <SolidColorBrush x:Name="OpenMouthBrush" Color="#00E5FF" />
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="OpenMouthScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Canvas x:Name="Equalizer" Opacity="0">
                <Rectangle x:Name="Bar0" Canvas.Left="69" Width="4" RadiusX="2" RadiusY="2" Fill="#FF4D8D" />
                <Rectangle x:Name="Bar1" Canvas.Left="76" Width="4" RadiusX="2" RadiusY="2" Fill="#FF4D8D" />
                <Rectangle x:Name="Bar2" Canvas.Left="83" Width="4" RadiusX="2" RadiusY="2" Fill="#FF4D8D" />
                <Rectangle x:Name="Bar3" Canvas.Left="90" Width="4" RadiusX="2" RadiusY="2" Fill="#FF4D8D" />
                <Rectangle x:Name="Bar4" Canvas.Left="97" Width="4" RadiusX="2" RadiusY="2" Fill="#FF4D8D" />
            </Canvas>

            <!-- Error tint -->
            <Rectangle x:Name="ErrorTint" Canvas.Left="22" Canvas.Top="32" Width="126" Height="114" RadiusX="50" RadiusY="48"
                       Fill="#FF3B3B" Opacity="0" IsHitTestVisible="False" />

            <!-- Question badge (waiting for confirmation) -->
            <TextBlock x:Name="Badge" Canvas.Left="128" Canvas.Top="4" Text="?" FontSize="30" FontWeight="Bold"
                       Foreground="#FFB020" Opacity="0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FFB020" BlurRadius="12" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>
        </Canvas>
    </Canvas>
</UserControl>
