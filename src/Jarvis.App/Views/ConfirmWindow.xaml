<Window x:Class="Jarvis.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis — confirm action"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border CornerRadius="16" Padding="18,14" Background="#F7161A35" BorderBrush="#FFB020" BorderThickness="1.5" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#FFB020" BlurRadius="24" ShadowDepth="0" Opacity="0.45" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="⚠  Allow this action?" Foreground="#FFB020" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                <TextBlock x:Name="ActionText" Foreground="White" FontSize="14" TextWrapping="Wrap" />
            </ScrollViewer>
            <TextBlock x:Name="ReasonText" Foreground="#9AA7D6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DenyButton" Content="Deny (Esc)" IsCancel="True" Padding="14,6" Margin="0,0,8,0"
                        Background="#2A3170" Foreground="White" BorderBrush="#4A55A0" Cursor="Hand" />
                <Button x:Name="AllowButton" Content="Allow (Enter)" IsDefault="True" Padding="14,6"
                        Background="#FFB020" Foreground="#161A35" FontWeight="SemiBold" BorderBrush="#FFB020" Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
