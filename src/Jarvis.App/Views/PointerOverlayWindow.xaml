<Window x:Class="Jarvis.App.Views.PointerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis Pointer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False"
        Left="0" Top="0" Width="10" Height="10">
    <Canvas x:Name="Root">
        <Canvas x:Name="TrailLayer" />
        <Canvas x:Name="RippleLayer" />
        <Canvas x:Name="Pointer" Opacity="0">
            <Ellipse x:Name="Glow" Width="64" Height="64" Canvas.Left="-32" Canvas.Top="-32" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowStop" Color="#8000E5FF" Offset="0" />
                        <GradientStop Color="#0000E5FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path x:Name="Arrow"
                  Data="M0,0 L22,9 Q12.5,11.5 9,22 Z"
                  StrokeThickness="2" StrokeLineJoin="Round"
                  RenderTransformOrigin="0,0">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF2E3570" Offset="0" />
                        <GradientStop Color="#FF151833" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Stroke>
                    <SolidColorBrush x:Name="ArrowStroke" Color="#FF00E5FF" />
                </Path.Stroke>
                <Path.RenderTransform>
                    <ScaleTransform x:Name="ArrowScale" ScaleX="1" ScaleY="1" />
                </Path.RenderTransform>
                <Path.Effect>
                    <DropShadowEffect x:Name="ArrowGlow" Color="#00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                </Path.Effect>
            </Path>
            <Path x:Name="ArrowAccent" Data="M3,3 L10,10" StrokeThickness="1.6" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" Opacity="0.95" RenderTransformOrigin="0,0"
                  RenderTransform="{Binding RenderTransform, ElementName=Arrow}">
                <Path.Stroke>
                    <SolidColorBrush x:Name="AccentStroke" Color="#FF00E5FF" />
                </Path.Stroke>
            </Path>
            <Ellipse Width="3" Height="3" Canvas.Left="-1.5" Canvas.Top="-1.5" Fill="White" />
            <Border x:Name="Label" Canvas.Left="22" Canvas.Top="26" CornerRadius="9" Padding="9,4"
                    Background="#E61B1F3B" BorderBrush="#6600E5FF" BorderThickness="1" Opacity="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✦ " Foreground="#00E5FF" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabelText" Foreground="White" FontSize="12" FontFamily="Segoe UI"
                               MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Canvas>
    </Canvas>
</Window>
