<Window x:Class="Jarvis.App.Views.AvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Jarvis.App.Controls"
        Title="Jarvis"
        Width="400" Height="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0" />
            <GradientStop Color="#A07CFF" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Speech bubble -->
        <Grid x:Name="Bubble" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,30,-4"
              Opacity="0" IsHitTestVisible="{Binding IsVisible, ElementName=ReplyText}">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BubbleTranslate" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border CornerRadius="16" Padding="14,10" MaxWidth="340" MinWidth="120"
                    Background="#F0161A35" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="UserText" Foreground="#9AA7D6" FontStyle="Italic" FontSize="12.5"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4" />
                    <StackPanel x:Name="ActivityPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Ellipse x:Name="ActivityDot" Width="7" Height="7" Fill="#00E5FF" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ActivityText" Foreground="#00E5FF" FontSize="12.5" TextWrapping="Wrap" MaxWidth="290" />
                    </StackPanel>
                    <TextBlock x:Name="ReplyText" Foreground="White" FontSize="14" TextWrapping="Wrap"
                               Visibility="Collapsed" Margin="0,2,0,0" LineHeight="19" />
                </StackPanel>
            </Border>
            <Path Grid.Row="1" HorizontalAlignment="Right" Margin="0,-1,34,0" Data="M0,0 L18,0 L16,14 Z"
                  Fill="#F0161A35" Stroke="#A07CFF" StrokeThickness="1.5" />
        </Grid>

        <!-- Character -->
        <Grid x:Name="CharacterHost" Grid.Row="1"         Width="128" Height="143" HorizontalAlignment="Right" Margin="0,0,10,0"
              Background="#01000000" Cursor="Hand" ToolTip="Jarvis — double-click to talk, drag to move, right-click for menu">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="170" Height="190">
                            <controls:JarvisCharacter x:Name="Character" />
                            <controls:LottieAvatar x:Name="Lottie" Visibility="Collapsed" />
                        </Grid>
                    </Viewbox>
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="TalkItem" Header="🎙  Talk" />
                    <MenuItem x:Name="TypeItem" Header="⌨  Type a command" />
                    <MenuItem x:Name="StopItem" Header="■  Stop" />
                    <Separator />
                    <MenuItem x:Name="ResetItem" Header="↺  New conversation" />
                    <MenuItem x:Name="ExtensionItem" Header="🧩  Install Chrome extension" />
                    <MenuItem x:Name="SettingsItem" Header="⚙  Open settings" />
                    <MenuItem x:Name="LogsItem" Header="📄  Open logs" />
                    <Separator />
                    <MenuItem x:Name="ExitItem" Header="Exit" />
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Grid>
</Window>
