{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "Jarvis": {
    "Llm": {
      "Provider": "Ollama",
      "Model": "gemma4",
      "Endpoint": null,
      "MaxSteps": 30,
      "Temperature": 0.2,
      "MaxOutputTokens": 2048,
      "HistoryMessageLimit": 40,
      "RunTimeout": "00:05:00",
      "ContextLength": 16384
    },
    "Voice": {
      "Engine": "Hybrid",
      "WhisperModel": "medium",
      "Language": "auto",
      "AllowedLanguages": [ "en", "uk" ],
      "SilenceTimeoutMs": 1500,
      "MaxRecordingSeconds": 30,
      "SilenceThreshold": 0.015
    },
    "Hotkeys": {
      "Talk": "Ctrl+Space",
      "Type": "Ctrl+Alt+J",
      "Stop": "Ctrl+Alt+X"
    },
    "Browser": {
      "ChromePath": null,
      "DebugPort": 9222,
      "ProfileDirectory": null,
      "SnapshotElementLimit": 100,
      "ReadTextLimit": 4000
    },
    "Safety": {
      "Mode": "ConfirmRisky",
      "ConfirmationTimeout": "00:01:00"
    },
    "Ui": {
      "HideFromScreenCapture": true,
      "Sounds": true
    }
  }
}
