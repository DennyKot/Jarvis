{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "Jarvis": {
    "Llm": {
      "Provider": "Ollama",
      "Model": "gemma4",
      "Endpoint": null,
      "MaxSteps": 30,
      "Temperature": 0.2,
      "MaxOutputTokens": 1024,
      "HistoryMessageLimit": 40,
      "RunTimeout": "00:05:00",
      "ContextLength": 16384,
      "KeepAlive": "30m",
      "AllowMultipleToolCalls": true,
      "DynamicTools": true
    },
    "Voice": {
      "Engine": "Hybrid",
      "WhisperModel": "medium",
      "Language": "auto",
      "AllowedLanguages": [ "en", "uk" ],
      "SilenceTimeoutMs": 900,
      "MaxRecordingSeconds": 30,
      "SilenceThreshold": 0.015,
      "WakeWordEnabled": false,
      "WakeWords": [ "hey jarvis", "hi jarvis", "ok jarvis", "okay jarvis", "jarvis", "привіт джарвіс", "джарвіс" ]
    },
    "Hotkeys": {
      "Talk": "Ctrl+Space",
      "Type": "Ctrl+Alt+J",
      "Stop": "Ctrl+Alt+X",
      "Undo": "Ctrl+Alt+Z"
    },
    "Browser": {
      "ChromePath": null,
      "DebugPort": 9222,
      "ProfileDirectory": null,
      "SnapshotElementLimit": 60,
      "ReadTextLimit": 2500
    },
    "Safety": {
      "Mode": "ConfirmRisky",
      "ConfirmationTimeout": "00:01:00",
      "PreviewPlan": false
    },
    "Ui": {
      "HideFromScreenCapture": true,
      "Sounds": true
    }
  }
}
